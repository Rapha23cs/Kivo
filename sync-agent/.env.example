# ==========================================
# KIVO SYNC AGENT - VARIÁVEIS DE AMBIENTE
# (Configure essas variáveis no painel do Coolify)
# ==========================================

# 1. Configurações do Supabase Cloud
# Geradas em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seuprojeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...sua_service_role_key_secreta

# 2. Configurações do Sistema Interno "Gerenciamento Ambiental"
# Se rodar no mesmo Coolify via rede Docker: http://gerenciamento-ambiental:porta/api/vistorias
# Se rodar em outro IP na rede interna: http://192.168.1.100:8000/api/vistorias
ENVIRONMENTAL_API_URL=http://gerenciamento-ambiental:8000/api/vistorias
ENVIRONMENTAL_API_TOKEN=seu_token_jwt_ou_bearer_aqui

# 3. Intervalo de Consulta ao Supabase (em minutos)
SYNC_INTERVAL_MINUTES=10

# 4. Modo de Simulação / Teste (Dry Run)
# Se "true", o agente busca as inspeções no Supabase, formata os dados e apenas exibe no log
# sem fazer o POST no sistema interno nem alterar o status no Supabase.
DRY_RUN=false
